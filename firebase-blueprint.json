{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Senior funeral fund member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "age": { "type": "number" },
        "village": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["normal", "unpaid", "deceased", "withdrawn"] },
        "joinDate": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 50 },
        "nominee": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 },
        "collectorId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "village", "status"]
    },
    "CollectionRecord": {
      "title": "CollectionRecord",
      "description": "Monthly fee collection record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "memberId": { "type": "string", "maxLength": 128 },
        "period": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "unpaid"] },
        "paidDate": { "type": "string", "maxLength": 50 },
        "collectorId": { "type": "string", "maxLength": 128 },
        "receiptNumber": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "memberId", "period", "status"]
    },
    "DeceasedRecord": {
      "title": "DeceasedRecord",
      "description": "Deceased member and subsidy record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "memberId": { "type": "string", "maxLength": 128 },
        "period": { "type": "string", "maxLength": 50 },
        "deathDate": { "type": "string", "maxLength": 50 },
        "subsidyAmount": { "type": "number" },
        "paidDate": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "memberId", "period", "deathDate"]
    },
    "CollectorRoute": {
      "title": "CollectorRoute",
      "description": "Collector route and assigned village",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "village": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "assignedMembersCount": { "type": "number" }
      },
      "required": ["id", "name", "village"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Members collection"
    },
    "/collections/{collectionId}": {
      "schema": "CollectionRecord",
      "description": "Collections collection"
    },
    "/deceased/{deceasedId}": {
      "schema": "DeceasedRecord",
      "description": "Deceased records collection"
    },
    "/collectors/{collectorId}": {
      "schema": "CollectorRoute",
      "description": "Collectors collection"
    }
  }
}
